#!/usr/bin/env bash
set -uo pipefail

NEOCAT_HOME="${NEOCAT_HOME:-/srv/neocatecumenal}"
NEOCAT_CONFIG_DIR="${NEOCAT_CONFIG_DIR:-/etc/neocatecumenal}"
NEOCAT_COMPOSE_FILE="${NEOCAT_COMPOSE_FILE:-$NEOCAT_HOME/deploy/compose.yaml}"
NEOCAT_COMPOSE_PROJECT="${NEOCAT_COMPOSE_PROJECT:-neocatecumenal}"
NEOCAT_ENV_FILE="${NEOCAT_ENV_FILE:-$NEOCAT_HOME/.env}"
NEOCAT_BACKUP_DIR="${NEOCAT_BACKUP_DIR:-/mnt/neocatecumenal-backups}"
NEOCAT_BACKUP_REQUIRE_MOUNT="${NEOCAT_BACKUP_REQUIRE_MOUNT:-true}"
NEOCAT_RESTIC_IMAGE="${NEOCAT_RESTIC_IMAGE:-restic/restic@sha256:93999df80d4ac6cb148e82d2ef1fe6a81996f17ff535e772723538211b31555a}"
NEOCAT_DATABASE="${NEOCAT_DATABASE:-neocatecumenal}"

settings_file="$NEOCAT_CONFIG_DIR/backup.env"

load_setting() {
  local name="$1" default="$2" value
  if [ -z "${!name:-}" ]; then
    value=""
    [ -f "$settings_file" ] && value="$(sed -n "s/^$name=//p" "$settings_file" | tail -n 1)"
    export "$name=${value:-$default}"
  fi
}

load_setting RESTIC_REPOSITORY "$NEOCAT_BACKUP_DIR/restic"
load_setting RESTIC_PASSWORD_FILE "$NEOCAT_CONFIG_DIR/restic.password"
load_setting NEOCAT_BACKUP_MAX_USE 80
load_setting NEOCAT_BACKUP_RETENTION 30d
load_setting NEOCAT_BACKUP_CHECK_DAY 7
load_setting NEOCAT_PING_BACKUP ""

export COMPOSE_FILE="$NEOCAT_COMPOSE_FILE"
export COMPOSE_PROJECT_NAME="$NEOCAT_COMPOSE_PROJECT"
export NEOCAT_HOME

log() {
  printf '%s\n' "$*"
}

ping_backup() {
  local suffix="$1" text="$2"
  [ -n "$NEOCAT_PING_BACKUP" ] || return 0
  curl -s -m 10 --retry 3 -o /dev/null --data-raw "$text" "$NEOCAT_PING_BACKUP$suffix" \
    || log "no se pudo avisar a la comprobación de copias"
}

fail() {
  log "$1"
  ping_backup "/fail" "$1"
  exit 1
}

compose() {
  local env_args=()
  [ -f "$NEOCAT_ENV_FILE" ] && env_args=(--env-file "$NEOCAT_ENV_FILE")
  docker compose ${env_args[@]+"${env_args[@]}"} "$@"
}

restic() {
  docker run --rm -i --network none --read-only --cap-drop ALL --security-opt no-new-privileges:true \
    --tmpfs /tmp --user "$(id -u):$(id -g)" --hostname neocatecumenal \
    -e TZ=UTC -e RESTIC_REPOSITORY -e RESTIC_PASSWORD_FILE=/run/secrets/restic_password -e RESTIC_CACHE_DIR=/tmp/restic-cache \
    -v "$RESTIC_PASSWORD_FILE:/run/secrets/restic_password:ro" -v "$NEOCAT_BACKUP_DIR:$NEOCAT_BACKUP_DIR" "$NEOCAT_RESTIC_IMAGE" "$@"
}

dump_database() {
  compose exec -T postgres sh -c 'user="$(cat /run/secrets/database_username)"; exec pg_dump -U "$user" -d "$0" -Fc --exclude-table-data=identity_session --exclude-table-data="identity_login_*_throttle"' "$NEOCAT_DATABASE"
}

is_mounted() {
  local mount_point real_dir
  [ -d "$NEOCAT_BACKUP_DIR" ] || return 1
  mount_point="$(df -P "$NEOCAT_BACKUP_DIR" 2>/dev/null | awk 'NR==2 {print $NF}')"
  real_dir="$(cd "$NEOCAT_BACKUP_DIR" && pwd -P)"
  [ -n "$mount_point" ] && [ "$mount_point" = "$real_dir" ]
}

partition_usage() {
  df -P "$NEOCAT_BACKUP_DIR" 2>/dev/null | awk 'NR==2 {gsub("%", "", $5); print $5}'
}

ensure_repository() {
  restic cat config >/dev/null 2>&1 && return 0
  if [ ! -d "$RESTIC_REPOSITORY" ] || [ -z "$(ls -A "$RESTIC_REPOSITORY")" ]; then
    mkdir -p "$RESTIC_REPOSITORY" && restic init >/dev/null 2>&1
    return
  fi
  return 1
}

oldest_snapshot_time() {
  restic snapshots --json 2>/dev/null | grep -o '"time":"[^"]*"' | sed 's/^"time":"\(.*\)"$/\1/' | sort | head -n 1
}

utc_days_ago() {
  date -u -v-"$1"d '+%Y-%m-%dT%H:%M:%S' 2>/dev/null || date -u -d "$1 days ago" '+%Y-%m-%dT%H:%M:%S'
}

take_snapshot() {
  local statuses output snapshot_id
  statuses="$(mktemp)"
  output="$({ dump_database 2>/dev/null; printf '%s' "$?" >"$statuses"; } \
    | restic backup --json --stdin --stdin-filename neocatecumenal.dump --host neocatecumenal 2>/dev/null)"
  local restic_status=$? dump_status
  dump_status="$(cat "$statuses")"
  rm -f "$statuses"
  snapshot_id="$(printf '%s' "$output" | sed -n 's/.*"snapshot_id":"\([0-9a-f]*\)".*/\1/p' | tail -n 1)"
  if [ "$dump_status" != "0" ] || [ "$restic_status" -ne 0 ]; then
    [ -n "$snapshot_id" ] && restic forget --prune "$snapshot_id" >/dev/null 2>&1
    return 1
  fi
}

ping_backup "/start" ""

if [ "$NEOCAT_BACKUP_REQUIRE_MOUNT" = "true" ] && ! is_mounted; then
  fail "partición de copias sin montar"
fi

[ -s "$RESTIC_PASSWORD_FILE" ] || fail "fallo de copia"
ensure_repository || fail "fallo de copia"

log "volcando la base de datos al repositorio de copias"
take_snapshot || fail "fallo de copia"

restic forget --keep-within-daily "$NEOCAT_BACKUP_RETENTION" --prune >/dev/null 2>&1 || fail "fallo de copia"

oldest="$(oldest_snapshot_time)"
[ -n "$oldest" ] || fail "fallo de copia"
if [[ "${oldest:0:19}" < "$(utc_days_ago 31)" ]]; then
  fail "instantánea de copia demasiado antigua"
fi

usage="$(partition_usage)"
if [ -z "$usage" ] || [ "$usage" -ge "$NEOCAT_BACKUP_MAX_USE" ]; then
  fail "partición de copias casi llena"
fi

if [ "$(date +%u)" = "$NEOCAT_BACKUP_CHECK_DAY" ]; then
  restic check >/dev/null 2>&1 || fail "comprobación de integridad fallida"
  log "comprobación de integridad correcta"
fi

log "copia correcta"
ping_backup "" "copia correcta"
