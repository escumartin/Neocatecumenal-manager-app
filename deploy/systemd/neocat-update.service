[Unit]
Description=Actualizador de Neocatecumenal
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/neocat-update
TimeoutStartSec=900
Environment=DOCKER_CONFIG=/etc/neocatecumenal/docker
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
ReadWritePaths=/srv/neocatecumenal/state
