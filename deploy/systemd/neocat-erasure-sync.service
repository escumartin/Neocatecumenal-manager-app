[Unit]
Description=Copia extra de Neocatecumenal si hay supresiones sin copiar
Wants=docker.service
After=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/neocat-erasure-sync
TimeoutStartSec=1800
Environment=DOCKER_CONFIG=/etc/neocatecumenal/docker
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
ReadWritePaths=-/mnt/neocatecumenal-backups
